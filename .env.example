# Point at the mock layer by default. Flip these two (and VITE_USE_MOCKS=false)
# once the backend team ships the real API + WebSocket gateway — nothing else
# in the frontend needs to change.
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8787/ws
VITE_USE_MOCKS=true

# foom_attendance public API (shift list + task lists). Optional — derived from
# VITE_API_BASE_URL's host + /foom/attendance/api when unset.
# VITE_ATTENDANCE_API_URL=https://<odoo-domain>/foom/attendance/api

# foom_wms_api (warehouse + location pickers on the Settings page). The URL is
# optional — derived from VITE_API_BASE_URL's host + /api/wms/v1 when unset.
# The key is an Odoo user API key; set it in .env.local or the host's env, never commit it.
# VITE_WMS_API_URL=https://<odoo-domain>/api/wms/v1
VITE_WMS_API_KEY=

# Store Connect KDM stock webhook, called after each prep (manufacturing order done).
# Leave the URL empty to turn the sync off. The secret differs per environment;
# set it in .env.local or the host's env, never commit it.
VITE_STORE_CONNECT_URL=
VITE_STORE_CONNECT_SECRET=
