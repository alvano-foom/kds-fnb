# Point at the mock layer by default. Flip these two (and VITE_USE_MOCKS=false)
# once the backend team ships the real API + WebSocket gateway — nothing else
# in the frontend needs to change.
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8787/ws
VITE_USE_MOCKS=true

# foom_attendance public API (shift list + task lists). Optional — derived from
# VITE_API_BASE_URL's host + /foom/attendance/api when unset.
# VITE_ATTENDANCE_API_URL=https://<odoo-domain>/foom/attendance/api

# --- Server-only (no VITE_ prefix): read by this app's backend (server/), never bundled. ---
# Set them where the backend runs: .env.local for npm run dev / dev:staging, Vercel project
# env vars, or the process env of `npm start` on your own server. Never commit real values.

# KDS API the backend calls as the logged-in user. Defaults to VITE_API_BASE_URL when unset.
# KDS_API_BASE_URL=https://<odoo-domain>/api/kds

# foom_wms_api key (Odoo user API key with a WMS role) for the Settings warehouse/location pickers.
# WMS_API_URL defaults to the KDS API host + /api/wms/v1.
# WMS_API_URL=https://<odoo-domain>/api/wms/v1
WMS_API_KEY=

# Store Connect KDM stock webhook, called after each prep. Empty URL = sync off.
STORE_CONNECT_URL=
STORE_CONNECT_SECRET=
