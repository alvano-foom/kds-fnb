# Point at the mock layer by default. Flip these two (and VITE_USE_MOCKS=false)
# once the backend team ships the real API + WebSocket gateway — nothing else
# in the frontend needs to change.
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8787/ws
VITE_USE_MOCKS=true

# foom_attendance public API (shift list + task lists). Optional — derived from
# VITE_API_BASE_URL's host + /foom/attendance/api when unset.
# VITE_ATTENDANCE_API_URL=https://<odoo-domain>/foom/attendance/api
