# Point at the mock layer by default. This file is also what `npm test`
# loads (Vitest's default mode is "test", and Vite falls back to plain
# .env when there's no .env.test), so keep it on mocks — MSW's handlers
# (src/api/mocks/handlers.js) only intercept relative /api/... paths, and
# pointing this at a real absolute URL breaks the test suite.
#
# For the real staging backend, see .env.staging + the "npm run dev:staging"
# / "npm run build:staging" scripts instead of editing this file.
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8787/ws
VITE_USE_MOCKS=true
